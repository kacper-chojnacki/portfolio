---
---

<div class="flex items-center justify-between mb-8 sm:mb-10">
  <a href="/" id="logo-link" class="logo-brand no-underline tracking-tight hover:opacity-100" aria-label="Kacper Chojnacki | Home">
    <span id="logo-wrapper" class="logo-wrapper">
      <span class="logo-letter" aria-hidden="true">K</span>
      <span class="logo-fold logo-fold-1" aria-hidden="true">acper</span>
      <span class="logo-letter" aria-hidden="true">Ch</span>
      <span class="logo-fold logo-fold-2" aria-hidden="true">ojnacki</span>
      <span class="logo-dot" style="color: var(--color-accent);" aria-hidden="true">.</span>
    </span>
  </a>

  <div class="controls">
    <button
      id="lang-toggle"
      class="control-btn"
      aria-label="Switch language"
      title="Switch language"
    >
      EN
    </button>

    <button
      id="theme-toggle"
      class="control-btn"
      aria-label="Toggle theme"
      title="Toggle theme"
    >
      <svg id="icon-sun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
      </svg>
      <svg id="icon-moon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
      </svg>
    </button>
  </div>
</div>

<style>
  .logo-brand {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1;
    display: inline-flex;
    align-items: baseline;
    color: inherit;
    transition: color 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .logo-wrapper {
    display: inline-flex;
    align-items: baseline;
    overflow: hidden;
    white-space: nowrap;
  }

  .logo-letter {
    display: inline-block;
    flex-shrink: 0;
  }

  /* Sliding folders that unfold from left to right */
  .logo-fold {
    display: inline-block;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    transition: max-width 0.65s cubic-bezier(0.25, 1, 0.5, 1),
                opacity 0.45s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .logo-dot {
    display: inline-block;
    flex-shrink: 0;
  }

  /* Expanded state — when .logo-expanded class is on the wrapper */
  .logo-wrapper.logo-expanded .logo-fold-1 {
    max-width: 6ch;
    opacity: 1;
  }

  .logo-wrapper.logo-expanded .logo-fold-2 {
    max-width: 8ch;
    opacity: 1;
  }

  /* Hover trigger on the link itself */
  .logo-brand:hover .logo-fold-1 {
    max-width: 6ch;
    opacity: 1;
  }

  .logo-brand:hover .logo-fold-2 {
    max-width: 8ch;
    opacity: 1;
  }
</style>

<script>
  // Theme toggle
  const themeBtn = document.getElementById('theme-toggle')!;
  const iconSun = document.getElementById('icon-sun')!;
  const iconMoon = document.getElementById('icon-moon')!;

  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    iconSun.classList.toggle('hidden', !isDark);
    iconMoon.classList.toggle('hidden', isDark);
  }

  updateThemeIcons();

  themeBtn.addEventListener('click', () => {
    document.documentElement.classList.add('theme-transitioning');
    document.documentElement.classList.toggle('dark');
    const isDark = document.documentElement.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateThemeIcons();
    // Buffer increased to 800ms so the 400ms CSS transitions complete fully
    setTimeout(() => {
      document.documentElement.classList.remove('theme-transitioning');
    }, 800);
  });

  // Language toggle
  const langBtn = document.getElementById('lang-toggle')!;
  let lang = localStorage.getItem('lang') || 'en';

  function applyLang(animate = false) {
    const mainContent = document.getElementById('main-content');
    const elements = document.querySelectorAll('[data-en]');

    if (animate && elements.length > 0) {
      let startHeight = 0;
      if (mainContent) {
        startHeight = mainContent.offsetHeight;
        mainContent.style.height = `${startHeight}px`;
        mainContent.style.overflow = 'hidden';
        mainContent.style.transition = 'height 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
      }

      elements.forEach(el => {
        if (el instanceof HTMLElement) {
          el.style.transition = 'opacity 0.15s cubic-bezier(0.4, 0, 0.2, 1)';
          el.style.opacity = '0';
        }
      });

      setTimeout(() => {
        updateDOM();

        if (mainContent) {
          mainContent.style.height = 'auto';
          const endHeight = mainContent.offsetHeight;
          mainContent.style.height = `${startHeight}px`;
          mainContent.offsetHeight; // force reflow
          mainContent.style.height = `${endHeight}px`;
        }

        elements.forEach(el => {
          if (el instanceof HTMLElement) {
            el.style.transition = 'opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1)';
            el.style.opacity = '1';
          }
        });

        setTimeout(() => {
          if (mainContent) {
            mainContent.style.height = '';
            mainContent.style.overflow = '';
            mainContent.style.transition = '';
          }
          elements.forEach(el => {
            if (el instanceof HTMLElement) {
              el.style.transition = '';
              el.style.opacity = '';
            }
          });
        }, 300);
      }, 150);
    } else {
      updateDOM();
    }
  }

  function updateDOM() {
    document.querySelectorAll('[data-en]').forEach(el => {
      const text = lang === 'pl' ? el.getAttribute('data-pl') : el.getAttribute('data-en');
      if (text !== null) el.innerHTML = text;
    });
    langBtn.textContent = lang === 'en' ? 'EN' : 'PL';
    document.documentElement.lang = lang;
  }

  applyLang(false);

  langBtn.addEventListener('click', () => {
    lang = lang === 'en' ? 'pl' : 'en';
    localStorage.setItem('lang', lang);
    applyLang(true);
  });

  // Logo intro animation: expand "KacperChojnacki." briefly then collapse to "KCh."
  const logoWrapper = document.getElementById('logo-wrapper');
  if (logoWrapper) {
    // Small delay so transition properties are registered
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        // Step 1: expand to full name
        logoWrapper.classList.add('logo-expanded');

        // Step 2: after 1.2s collapse back to "KCh."
        setTimeout(() => {
          logoWrapper.classList.remove('logo-expanded');
        }, 1200);
      });
    });
  }
</script>
