---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Kacper Chojnacki | Software Engineer',
  description = 'Software Engineer at Dynatrace | MSc Computer Science @ JKU Linz.',
} = Astro.props;
---

<!doctype html>
<!-- What are you looking for here? If you already managed to hack me - let me know how you did it! :) -->
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Kacper Chojnacki" />


    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL}social-preview.png?v=2`, Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(`${import.meta.env.BASE_URL}social-preview.png?v=2`, Astro.site).toString()} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="mx-auto max-w-[56rem] px-5 sm:px-12 py-8 sm:py-12 font-sans antialiased">
    <slot />
    <footer class="mt-16 pb-8 text-center">
      <p class="text-muted" style="font-size: 0.75rem; letter-spacing: 0.05em;" data-en="Last update: May 2026" data-pl="Ostatnia aktualizacja - Maj 2026">Last update: May 2026</p>
    </footer>
  </body>
</html>
